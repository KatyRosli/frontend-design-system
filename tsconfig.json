{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    "strict": true,

    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "declaration": true,
    "emitDeclarationOnly": true,

    "skipLibCheck": true,
    "isolatedModules": true,

    "resolveJsonModule": true,

    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
, "src/docs/voiceTone.mdx", "src/docs/accessibility.mdx", "src/docs/designPrinciples.mdx", "src/docs/introduction.mdx"  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}